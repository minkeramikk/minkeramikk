# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
PR-*-body.md
test-results/

# F26 backfill checkpoints (local run state, machine-specific)
scripts/.variants-progress.log
scripts/.variants-failed.log

# e2e evidence screenshots (PM material lives outside the repo)
docs/evidence/

# agent worktrees / local state (machine-specific, not source)
# Gli agenti e le skill di progetto SI committano; le impostazioni locali no
!.claude/
.claude/settings.local.json
.claude/worktrees/
# dev server del preview in-app: porta e comando dipendono dalla macchina
# (R5-POLISH-STEP23: sulla 3199 gira già il server di Daniele)
.claude/launch.json
# planning scratch (superpowers)
docs/superpowers/

# Supabase migration (segreti locali, mai committare)
.env.migration
Makefile.migration
catalog-data.sql
scripts/migrate-config.json
scripts/migrate-supabase.py
vercel-preview

scripts/__pycache__/
# e2e discount-seed crash recovery (local run state, see e2e/helpers.ts)
.e2e-discount-restore.json

# GitHub token per l'org minkeramikk (mai committare; sessioni dev: GH_TOKEN=$(cat .gh-token))
.gh-token

# Processo Varco: repo sua annidata, ignorata dal prodotto. Senza slash finale:
# nei worktree .varco può essere un symlink e un symlink non è una directory.
.varco
# Artefatti del piano: locali, mai committati
.superpowers/
.plans/
